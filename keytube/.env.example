# Neon PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# URL pública de tu aplicación en producción (necesaria para OAuth de Google)
APP_ORIGIN=https://tu-proyecto.vercel.app

# Inicio de sesión con Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Recuperación de cuenta por correo (Resend)
# Crea una API key con permiso de envío y usa un remitente/dominio verificado.
RESEND_API_KEY=
EMAIL_FROM=KeyTube <no-reply@tu-dominio.com>

# Vercel Blob (Vercel suele crear esta variable al conectar un Blob Store)
BLOB_READ_WRITE_TOKEN=

# Administradores de moderación (opcional). Separa varios correos con coma.
ADMIN_EMAILS=tu-correo@gmail.com
